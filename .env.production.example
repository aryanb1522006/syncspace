NODE_ENV=production
SITE_DOMAIN=syncspace.example.edu
PORT=4000

# Generate passwords and tokens with a cryptographically secure generator.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://syncspace:replace-with-a-long-random-database-password@postgres:5432/syncspace
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000

JWT_SECRET=replace-with-at-least-32-random-characters

# Google OAuth web client ID is public; the domain is enforced again by Express.
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id.apps.googleusercontent.com
AUTH_ALLOWED_EMAIL_DOMAIN=thapar.edu
PASSWORD_AUTH_ENABLED=false
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id.apps.googleusercontent.com
VITE_AUTH_ALLOWED_EMAIL_DOMAIN=thapar.edu
VITE_PASSWORD_AUTH_ENABLED=false
JWT_EXPIRES_IN=2h
CLIENT_ORIGIN=https://syncspace.example.edu
TRUST_PROXY=true
DEFAULT_COLLEGE_ID=1

STORAGE_DRIVER=s3
S3_BUCKET=syncspace-resumes
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=syncspace-storage
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-storage-password
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_PRESIGN_EXPIRES_SECONDS=300
MINIO_ROOT_USER=syncspace-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-password

LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-a-long-random-monitoring-token
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
SHUTDOWN_TIMEOUT_MS=10000
