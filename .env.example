NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syncspace
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
AUTH_ALLOWED_EMAIL_DOMAIN=
PASSWORD_AUTH_ENABLED=true
ADMIN_EMAILS=
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false
UPLOAD_DIR=uploads
STORAGE_DRIVER=local
DEFAULT_COLLEGE_ID=1
LOG_LEVEL=debug
METRICS_ENABLED=false
METRICS_TOKEN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
# Recommendation ML / embedding configuration
# EMBEDDING_PROVIDER=hashing (default): deterministic, offline, no setup needed.
# EMBEDDING_PROVIDER=transformers: real pretrained semantic embeddings. Requires:
#   1. `npm install` in server/ (the '@xenova/transformers' package is an
#      optional dependency, so it installs automatically, but isn't
#      required for the default hashing provider to work).
#   2. Outbound network access from this process to huggingface.co, at
#      least once, to download the model (~90MB for the default model).
#   3. If deploying via Docker: use a glibc-based image (e.g.
#      node:22-bookworm-slim, already the default in server/Dockerfile) -
#      onnxruntime-node's prebuilt native binary does not load on Alpine's
#      musl libc.
# If the model can't be loaded for any reason (package missing, no network,
# bad model name), this provider automatically and silently falls back to
# the hashing provider - check the server logs for a one-time warning
# explaining exactly why, so the app never crashes on a misconfiguration.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=256
# Persists downloaded transformers model weights across restarts/redeploys
# so the network download only ever has to happen once. Point this at a
# mounted persistent volume in production. Leave unset to use the
# library's own default (an ephemeral './.cache' next to node_modules).
EMBEDDING_CACHE_DIR=
SEMANTIC_SKILL_THRESHOLD=0.3
SKILL_SCORE_WEIGHT=0.5
COSINE_SCORE_WEIGHT=0.5
DUPLICATE_SIMILARITY_THRESHOLD=0.35
PROJECT_SUMMARY_WORD_LIMIT=50

VITE_GOOGLE_CLIENT_ID=
VITE_AUTH_ALLOWED_EMAIL_DOMAIN=thapar.edu
VITE_PASSWORD_AUTH_ENABLED=true
